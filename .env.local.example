# --- Auth ---
# Username for the admin account that can view/save reports
AUTH_USERNAME=admin

# bcrypt hash of the admin password. Generate one with:
#   npm run hash -- "your-password-here"
#
# IMPORTANT: bcrypt hashes contain '$' characters which Next.js treats as
# variable references. Escape each '$' with a backslash. Example:
#   raw hash:     $2a$10$Mb.or5w8JaPKt0K7vMCqHe7TWX5zHBmGC/3NoTD0vjP0FKGODGmOK
#   in .env:     \$2a\$10\$Mb.or5w8JaPKt0K7vMCqHe7TWX5zHBmGC/3NoTD0vjP0FKGODGmOK
# (On Vercel's env var UI, paste the raw value — no escaping needed there.)
AUTH_PASSWORD_HASH=\$2a\$10\$REPLACE_WITH_HASH_FROM_SCRIPT

# Secret used to sign JWT session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Vercel Blob (auto-populated when you add Blob storage on Vercel) ---
# Get this from your Vercel project: Storage -> Blob -> .env.local tab
BLOB_READ_WRITE_TOKEN=
